{
  "name": "messenger-app",
  "version": "1.3.0",
  "description": "Standalone Facebook Messenger app for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64 --x64 --publish never",
    "check": "node --check main.js && node --check preload.js",
    "build:arm64": "electron-builder --mac --arm64 --publish never",
    "build:x64": "electron-builder --mac --x64 --publish never"
  },
  "author": "Stefan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.stefan.messenger",
    "productName": "MessengerApp",
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
